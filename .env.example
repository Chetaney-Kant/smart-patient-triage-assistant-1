# ==========================================
# MediTriage Application Environment Configuration
# ==========================================

# ------------------------------------------
# Database Configuration (PostgreSQL / Azure Database for PostgreSQL)
# ------------------------------------------
SPRING_PROFILES_ACTIVE=postgres
DATABASE_URL=jdbc:postgresql://postgres:5432/triagedb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword

# ------------------------------------------
# Security & JWT Token Secrets
# ------------------------------------------
JWT_SECRET=HealthcareTriageSecretKeyMustBeAtLeast256BitsLongForHS256AlgorithmSecurity2026

# ------------------------------------------
# Google OAuth 2.0 Credentials
# ------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------
# SMTP Email Service (Gmail / Azure Communication Services / SendGrid)
# ------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ------------------------------------------
# Clinical AI Engine (Gemini / Claude / Fallback)
# ------------------------------------------
AI_ENABLED=true
AI_PROVIDER=fallback
GEMINI_API_KEY=
